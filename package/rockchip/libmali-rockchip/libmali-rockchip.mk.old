LIBMALI_ROCKCHIP_SITE = https://github.com/tsukumijima/libmali-rockchip.git
LIBMALI_ROCKCHIP_VERSION = bd33ee2
LIBMALI_ROCKCHIP_SITE_METHOD = git
LIBMALI_ROCKCHIP_LICENSE = LGPL-2.1
LIBMALI_ROCKCHIP_LICENSE_FILES = COPYING

LIBMALI_ROCKCHIP_CONF_OPTS = \
    -Darch=aarch64 \
    -Dgpu=valhall-g610 \
    -Dversion=g24p0 \
    -Dsubversion=none \
    -Dplatform=x11-gbm \
    -Doptimize-level=O2

LIBMALI_ROCKCHIP_DEPENDENCIES = libdrm xlib_libX11 libxcb

define LIBMALI_ROCKCHIP_PRE_CONFIGURE_FIXUP
    ln -sf lib $(@D)/optimize_2
endef
LIBMALI_ROCKCHIP_PRE_CONFIGURE_HOOKS += LIBMALI_ROCKCHIP_PRE_CONFIGURE_FIXUP

$(eval $(meson-package))